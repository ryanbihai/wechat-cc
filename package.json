{
  "name": "wechat-cc",
  "version": "0.1.0",
  "description": "WeChat Channel for Claude Code via OceanBus L0 P2P",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "start": "bun install --no-summary && bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "oceanbus": "latest",
    "weixin-bot-plugin": "^2.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
